local function CreateESP(player)
    if player == LocalPlayer then return end
    
    local function UpdateESP()
        safeCall(function()
            if not Settings.ESP.Enabled then
                if ESPObjects[player] then
                    ESPObjects[player]:Destroy()
                    ESPObjects[player] = nil
                end
                return
            end
            
            if not player or not player.Parent then return end
            if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then return end
            
            if not ESPObjects[player] then
                local Highlight = Instance.new("Highlight")
                Highlight.Adornee = player.Character
                Highlight.FillTransparency = 0.5
                Highlight.OutlineTransparency = 0
                Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                Highlight.Parent = player.Character
                ESPObjects[player] = Highlight
            end
            
            local highlight = ESPObjects[player]
            if not highlight then return end
            
            if Settings.ESP.TeamBased and player.Team then
                highlight.FillColor = player.Team.TeamColor.Color
                highlight.OutlineColor = player.Team.TeamColor.Color
            else
                highlight.FillColor = Settings.ESP.Color
                highlight.OutlineColor = Settings.ESP.Color
            end
            
            if Settings.ESP.ShowHealth and player.Character:FindFirstChild("Humanoid") then
                local humanoid = player.Character.Humanoid
                local healthPercent = humanoid.Health / humanoid.MaxHealth
                
                if healthPercent > 0.75 then
                    highlight.FillColor = Color3.fromRGB(0, 255, 0)
                elseif healthPercent > 0.5 then
                    highlight.FillColor = Color3.fromRGB(255, 255, 0)
                elseif healthPercent > 0.25 then
                    highlight.FillColor = Color3.fromRGB(255, 165, 0)
                else
                    highlight.FillColor = Color3.fromRGB(255, 0, 0)
                end
            end
        end)
    end
    
    player.CharacterAdded:Connect(function()
        task.wait(0.5)
        UpdateESP()
    end)
    
    RunService.RenderStepped:Connect(UpdateESP)
end

local function CreateChams(player)
    if player == LocalPlayer then return end
    
    local function UpdateChams()
        safeCall(function()
            if not Settings.Chams.Enabled then
                if ChamsObjects[player] then
                    for _, obj in pairs(ChamsObjects[player]) do
                        if obj then obj:Destroy() end
                    end
                    ChamsObjects[player] = nil
                end
                return
            end
            
            if not player or not player.Parent then return end
            if not player.Character then return end
            
            ChamsObjects[player] = ChamsObjects[player] or {}
            
            for _, part in pairs(player.Character:GetDescendants()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    if not ChamsObjects[player][part] then
                        local Box = Instance.new("BoxHandleAdornment")
                        Box.Size = part.Size
                        Box.Adornee = part
                        Box.AlwaysOnTop = true
                        Box.ZIndex = 10
                        Box.Transparency = 0.3
                        Box.Parent = part
                        ChamsObjects[player][part] = Box
                    end
                    
                    local box = ChamsObjects[player][part]
                    if box then
                        if Settings.Chams.TeamBased and player.Team then
                            box.Color3 = player.Team.TeamColor.Color
                        else
                            box.Color3 = Settings.Chams.Color
                        end
                    end
                end
            end
        end)
    end
    
    player.CharacterAdded:Connect(function()
        task.wait(0.5)
        UpdateChams()
    end)
    
    RunService.RenderStepped:Connect(UpdateChams)
end

function ApplyNoRecoil()
    safeCall(function()
        if not Settings.NoRecoil then
            for obj, originalValue in pairs(OriginalRecoilValues) do
                if obj and obj.Parent then
                    obj.Value = originalValue
                end
            end
            OriginalRecoilValues = {}
            return
        end
        
        local function ProcessTool(tool)
            if not tool:IsA("Tool") then return end
            
            for _, obj in pairs(tool:GetDescendants()) do
                if obj:IsA("NumberValue") then
                    local name = obj.Name:lower()
                    if name:find("recoil") or name:find("spread") then
                        if not OriginalRecoilValues[obj] then
                            OriginalRecoilValues[obj] = obj.Value
                        end
                        obj.Value = 0
                    end
                end
            end
        end
        
        if LocalPlayer.Character then
            for _, tool in pairs(LocalPlayer.Character:GetChildren()) do
                ProcessTool(tool)
            end
        end
        
        if LocalPlayer:FindFirstChild("Backpack") then
            for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
                ProcessTool(tool)
            end
        end
    end)
end

