-- Função de proteção contra erros
local function safeCall(func)
    local success, err = pcall(func)
    if not success then
        warn("⚠️ Erro:", err)
    end
    return success
end

-- ============================================
-- SISTEMA DE HITBOX CORRIGIDO
-- ============================================
local function ApplyHitbox()
    safeCall(function()
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local part = player.Character:FindFirstChild(Settings.Hitbox.Part)
                
                if part and part:IsA("BasePart") then
                    if Settings.Hitbox.Enabled then
                        if not Settings.Hitbox.OriginalSizes[part] then
                            Settings.Hitbox.OriginalSizes[part] = part.Size
                        end
                        
                        -- APENAS aumentar tamanho - SEM mexer em outras propriedades
                        part.Size = Vector3.new(Settings.Hitbox.Size, Settings.Hitbox.Size, Settings.Hitbox.Size)
                        part.CanCollide = false
                    else
                        if Settings.Hitbox.OriginalSizes[part] then
                            part.Size = Settings.Hitbox.OriginalSizes[part]
                            part.CanCollide = true
                        end
                    end
                end
            end
        end
    end)
end

local function DisableHitbox()
    safeCall(function()
        for part, originalSize in pairs(Settings.Hitbox.OriginalSizes) do
            if part and part.Parent then
                part.Size = originalSize
                part.CanCollide = true
            end
        end
        Settings.Hitbox.OriginalSizes = {}
    end)
end

