                                    if player.Character and player.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                                        LocalPlayer.Character.HumanoidRootPart.CFrame = player.Character.HumanoidRootPart.CFrame
                                    end
                                elseif action.name:find("Spectate") then
                                    if player.Character and player.Character:FindFirstChild("Humanoid") then
                                        Camera.CameraSubject = player.Character.Humanoid
                                    end
                                elseif action.name:find("Stats") then
                                    if player.Character and player.Character:FindFirstChild("Humanoid") then
                                        local hum = player.Character.Humanoid
                                        print(string.format("Stats de %s:\nVida: %.0f/%.0f\nVelocidade: %.0f", player.Name, hum.Health, hum.MaxHealth, hum.WalkSpeed))
                                    end
                                end
                            end)
                        end)
                        
                        yPos = yPos + 45
                    end
                end)
            end
        end
        
        Container.Size = UDim2.new(1, 0, 0, Layout.AbsoluteContentSize.Y)
        ContentFrame.CanvasSize = UDim2.new(0, 0, 0, Layout.AbsoluteContentSize.Y + 20)
    end)
    
    CloseButton.MouseButton1Click:Connect(function()
        MainFrame.Visible = false
    end)
    
    MinButton.MouseButton1Click:Connect(function()
        MainFrame.Visible = false
    end)
    
    ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    return ScreenGui
end

